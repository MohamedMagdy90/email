# Ships inside dist/, the same reasoning as _redirects: netlify.toml only
# applies when Netlify builds from the repo, and a pre-built upload never
# sees it.

# The worker is the one file that must never be served stale. A cached
# sw.js pins every visitor to the build it was cached with.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Vite fingerprints these, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
